  items """Write the plan
Review it"""

def checklist
  items """[x] Security review
[ ] Launch post"""""""
      def heading "Quotes and callouts"
        level 2
      def quote "Simplicity is a prerequisite for reliability."
      def callout "Callouts come in four variants: info, success, warning and danger."
      def callout "Scope is frozen for this release."
        variant warning
      def code
        language jotx
        text """def callout "Scope is frozen for this release."
  variant warning"""
    def tab "Tables"
      def table plans "Plans"
        columns Plan, Price, Seats
        rows """Free | 0 | 1
Team | 8 | 10
Business | 20 | Unlimited"""
      def code
        language jotx
        text """"def table plans "Plans"
  columns Plan, Price, Seats
  rows """Free | 0 | 1
Team | 8 | 10"""""""
      def paragraph "In the editor, tables have a toolbar to add rows and columns, and a filter and sort for each column."
    def tab "Code and maths"
      def code
        language typescript
        text """export function greet(name: string): string {
  return `Hello, ${name}`
}"""
      def math energy "Mass–energy equivalence"
        src E = mc^2
      def code
        language jotx
        text """def code
  language typescript
  text export const answer = 42

def math energy "Mass–energy equivalence"
  src E = mc^2"""
      def paragraph "A code reference (def codereference with a path and lines) shows live code from a file in your workspace, in VS Code."
    def tab "Diagrams and charts"
      def mermaid sync "How a note becomes a page"
        src """flowchart LR
  A[.jot file] --> B[jotx parser]
  B --> C[Editor in VS Code]
  B --> D[jotx-doc on a web page]
  B --> E[jotx site build]"""

    def tab "Developer"
      def terminal "Getting started"
        shell zsh
        commands """$ npm install -g @jotx-labs/cli
added 42 packages
$ jotx site serve notes/
Preview at http://localhost:4000"""
      def api
        method POST
        path /api/v1/notes/{id}/blocks
        summary Append a block to a note
        request "{"type": "kanban", "title": "Sprint 12"}"
        response "{"id": "blk_42", "ok": true}"
      def filetree "jotx"
        tree """packages/
  core/  // parser and serializer
  editor/  // the block editor
  embed/  // the web script
  cli/  // validate, convert, site
README.md"""
      def diff "Fix the off-by-one"
        language typescript
        before for (let i = 0; i <= items.length; i++)
        after for (let i = 0; i < items.length; i++)
      def palette "jotx colours"
        colors """Teal | #0d9488
Ink | #1f2328
Mist | #f5f6f7
Violet | #7c3aed"""
      def shortcuts "Editor keys"
        items """/ | Block menu
Cmd+B | Bold
Cmd+I | Italic
Cmd+F | Search the note
Cmd+Z | Undo"""
      def animation "Saving a note"
        steps """Editor | You type
Webview | Changes are batched
Extension | The note is serialized
Disk | The .jot file is written"""
        speed "1.6"

  def heading "4. Roles & Responsibilities"
    level 2

  def table block_14
    def row
      def header
        text Role
      def header
        text Responsibilities
    def row
      def cell
        def paragraph "Account Executive (AE)"
      def cell
        def paragraph "Warm handoff to CSM, share customer goals & pain points from sales process"
    def row
      def cell
        def paragraph "Customer Success Manager (CSM)"
      def cell
        def paragraph "Lead onboarding, conduct kickoff, ensure activation, own customer relationship"
    def row
      def cell
        def paragraph "Implementation Specialist"
      def cell
        def paragraph "Technical setup, data migration, integrations, custom configuration"
    def row
      def cell
        def paragraph "Support Engineer"
      def cell
        def paragraph "Respond to technical issues, troubleshoot, escalate bugs to engineering"
    def row
      def cell

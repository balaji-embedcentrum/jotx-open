      def cell
        def paragraph "Attend sessions, complete training, drive internal adoption, provide feedback"

  def heading "5. Prerequisites"
    level 2

  def paragraph "Before starting onboarding, verify:"

  def checklist
    def listitem "Contract is fully executed and signed by both parties"
      checked "false"
      priority critical
    def listitem "Customer payment received or PO processed"
      checked "false"
      priority critical
    def listitem "Customer account created in CRM (Salesforce)"
      checked "false"
      priority high
    def listitem "CSM assigned and notified via email"
      checked "false"
      priority high
    def listitem "AE completes handoff form with customer context"
      checked "false"
      priority high
    def listitem "Customer receives welcome email with kickoff scheduling link"
      checked "false"
      priority medium

  def heading "6. Procedure Steps"
    level 2

  def mermaid block_19
    src """graph TD
    A[Contract Signed] --> B[Day 0: Warm Handoff]
    B --> C[Day 1-2: Kickoff Call]
    C --> D[Day 3-5: Account Setup]
    D --> E[Day 5-7: Training Sessions]
    E --> F[Day 7-10: Guided Usage]
    F --> G[Day 14: Business Review]
    G --> H{Activated?}
    H -->|Yes| I[Success - Handoff to Ongoing CSM]
    H -->|No| J[Remediation Plan]
    J --> F
    
    style A fill:#20B2AA,color:#0a0a0a
    style I fill:#20B2AA,color:#0a0a0a"""

  def heading "Phase 1: Warm Handoff (Day 0 - Within 24 hours of contract)"
    level 3

  def list
    listtype numbered
    items """AE completes handoff form in Salesforce (10 min)
CSM reviews account history, contract terms, and customer goals (30 min)
CSM sends personalized welcome email to customer champion (template: WEL-001)
CSM schedules kickoff call within 48 hours using Calendly link"""

  def callout "💡 Pro Tip: Review customer's website, LinkedIn, recent news to personalize your approach"

  def heading "Phase 2: Kickoff Call (Day 1-2 - 60 minutes)"
    level 3

  def paragraph "Goal: Align on objectives, timeline, and success criteria"

  def list
    listtype numbered
    items """Introductions and agenda review (5 min)
Understand customer's business goals and pain points (15 min)
Demonstrate platform capabilities relevant to their use case (20 min)
Co-create success plan and define activation milestones (15 min)
Schedule next 3 sessions (training, setup calls) (5 min)"""

  def callout "⚠️ Critical: Document 3 specific use cases customer wants to achieve in first 30 days"
    variant warning

  def heading "Phase 3: Account Setup & Configuration (Day 3-5)"
    level 3

  def list
    listtype numbered
    items """Implementation Specialist provisions customer workspace (30 min)
Configure SSO/SAML authentication if required (2 hours)
Import customer data (CSV upload or API sync) (1-3 hours)
Set up integrations (Slack, Salesforce, etc.) (1 hour each)
Create custom templates based on customer workflows (1 hour)
CSM sends setup completion email with login credentials"""

  def heading "Phase 4: Training Sessions (Day 5-7)"
    level 3

  def paragraph "Deliver role-based training to customer team"

  def table block_31
    def row
      def header
        text Session
      def header
        text Duration
      def header
        text Attendees
    def row
      def cell
        def paragraph "Admin Training"
      def cell
        def paragraph "90 min"
      def cell
        def paragraph "IT Admin, Champion"
    def row
      def cell
        def paragraph "End User Training"
      def cell
        def paragraph "60 min"
      def cell
        def paragraph "All users (recorded)"
    def row
      def cell
        def paragraph "Power User Training"
      def cell
        def paragraph "45 min"
      def cell
        def paragraph "5-10 key users"

  def heading "Phase 5: Guided Usage & Support (Day 7-10)"
    level 3

  def list
    listtype numbered
    items """CSM checks in daily via Slack/Email to answer questions
Monitor product usage analytics dashboard for adoption signals
Proactively reach out if usage is below expected levels
Share best practices and tips via customer Slack channel
Resolve any blockers within 4 hours (P0) or 24 hours (P1)"""

  def heading "Phase 6: Business Review (Day 14)"
    level 3

  def paragraph "30-minute call to review progress and next steps"

  def list
    listtype numbered
    items """Review usage metrics and activation status
Celebrate wins and quick wins achieved
Identify remaining blockers or training needs
Co-create 30-60-90 day success plan
Transition to quarterly business reviews"""


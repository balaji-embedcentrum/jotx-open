hdef jotx CustomerOnboardingS

  type page
  title SOP: Customer Onboarding Process
  icon 👋
  author Operations Team
  created 2025-01-10
  tags "process", "sop", "onboarding", "customer-success"

  def table block_1
    columns Key, Value
    rows """Version | 2.1
Owner | Customer Success Team
Last Updated | 2025-01-10
Review Cycle | Quarterly
Compliance | ISO 9001, GDPR"""

  def heading "SOP: New Customer Onboarding Process"

  def callout "✅ Objective: Deliver exceptional first-week experience, achieve 95% activation rate, and set customers up for long-term success"
    variant success

  def divider

  def heading "1. Purpose"
    level 2

  def paragraph "This SOP defines the standardized process for onboarding new enterprise customers from contract signature to successful activation. It ensures consistent, high-quality experiences that drive product adoption and customer satisfaction."

  def list
    items """Reduce time-to-value from 14 days to 7 days
Achieve 95%+ customer activation rate within first week
Establish foundation for long-term customer success
Maintain NPS score above 70 during onboarding"""

  def heading "2. Scope"
    level 2

  def paragraph "This SOP applies to all new enterprise customers (contract value > $25k/year)"

  def table block_10
    def row
      def header
        text In Scope
      def header
        text Out of Scope
    def row
      def cell
        def paragraph "Enterprise customers ($25k+/year)"
      def cell
        def paragraph "Self-service/SMB customers (< $25k)"
    def row
      def cell
        def paragraph "Initial account setup and configuration"
      def cell
        def paragraph "Ongoing customer success management"
    def row
      def cell
        def paragraph "First 30 days of customer journey"
      def cell
        def paragraph "Renewal or expansion activities"


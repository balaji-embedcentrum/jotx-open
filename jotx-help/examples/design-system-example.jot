hdef jotx AtlasDesignSystem

  type page
  title Atlas Design System v2.0
  icon 🌟
  author Design Team
  created 2025-01-15
  tags "design-system", "ui", "components", "atlas"

  def table block_1
    columns Key, Value
    rows """Version | 2.0.0
Last Updated | 2025-01-15
Maintainers | Design Ops Team
Figma Library | figma.com/atlas-ds"""

  def heading "Atlas Design System"

  def paragraph "Atlas is our unified design system powering all product experiences across web, iOS, and Android. It ensures consistency, accessibility, and efficiency in building user interfaces."

  def callout "🎯 Mission: Enable teams to build beautiful, accessible experiences 10x faster"

  def divider

  def heading "Design Principles"
    level 2

  def list
    listtype numbered
    items """**Clarity over Cleverness** - Simple, understandable interfaces trump novelty
**Consistent & Predictable** - Users should never be surprised by UI behavior
**Accessible by Default** - WCAG 2.1 AA compliance is non-negotiable
**Responsive & Adaptive** - Works beautifully on any screen size
**Performance First** - Fast loading, smooth animations, no jank"""

  def heading "Color Palette"
    level 2

  def heading "Brand Colors"
    level 3


  def code
    language typescript
    text """// React component usage
import { Button } from '@atlas/ui'

<Button variant="primary" size="md">
  Save Changes
</Button>

<Button variant="destructive" onClick={handleDelete}>
  Delete Account
</Button>"""

  def heading "Input Field"
    level 3

  def paragraph "Text input with label, helper text, and validation states"

  def code
    language typescript
    text """<TextField
  label="Email Address"
  placeholder="you@company.com"
  helperText="We'll never share your email"
  error={errors.email}
  required
/>"""

  def heading "Accessibility Standards"
    level 2

  def list
    items """✅ **WCAG 2.1 AA Compliant** - All color combinations meet 4.5:1 contrast minimum
✅ **Keyboard Navigation** - Tab order, focus traps, escape handlers
✅ **Screen Readers** - Semantic HTML, ARIA labels, live regions
✅ **Focus Management** - Clear 2px focus rings, skip links
✅ **Motion Reduced** - Respects prefers-reduced-motion"""

  def heading "Design Tokens"
    level 2

  def paragraph "Our design tokens are platform-agnostic and compile to CSS, iOS, and Android formats"

  def code
    language json
    text """{
  "color": {
    "primary": "#2563EB",
    "primary-hover": "#1D4ED8",
    "primary-active": "#1E40AF"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px"
  },
  "typography": {
    "body": {
      "font-family": "Inter",
      "font-size": "16px",
      "line-height": "24px"
    }
  }
}"""

  def heading "Resources & Tools"

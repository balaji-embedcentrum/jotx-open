  def heading "📦 Installation & Upgrade"
    level 2

  def heading "New Installation"
    level 3

  def code
    language bash
    text npm install @atlas/design-system@2.0.0\nnpm install @atlas/icons@2.0.0

  def heading "Upgrade from v1.x"
    level 3

  def code
    language bash
    text "# Install migration CLI\nnpm install -g @atlas/cli\n\n# Run automated migration\natlas-cli migrate v1-to-v2\n\n# Review changes and test\nnpm test\n\n# Update dependencies\nnpm install @atlas/design-system@latest @atlas/icons@latest"

  def heading "Migration Guide"
    level 3

  def paragraph "Comprehensive migration guide available at: docs.atlasdesign.com/migration/v1-to-v2"

  def list
    items """Step-by-step instructions for each breaking change
Automated codemod scripts for common patterns
Before/after examples for all changed components
Estimated migration time: 2-4 hours for typical project"""

  def divider


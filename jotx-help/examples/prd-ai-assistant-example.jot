  def heading "Go-to-Market Strategy"
    level 2

  def list
    items """📣 Launch campaign: \"Your AI Writing Partner\" with video demos
💎 Premium-only for first month, then limited free tier (5 requests/day)
📧 Email sequence to active users highlighting key use cases
🎁 Early adopter bonus: 50% off premium for 3 months
📱 Social proof: Case studies from beta users"""

  def heading "Open Questions"
    level 2


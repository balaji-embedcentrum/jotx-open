      def cell
        def paragraph "Clear labeling, easy editing, emphasize human control"
    def row
      def cell
        def paragraph "OpenAI API downtime affects service"
      def cell
        def paragraph "Medium"
      def cell
        def paragraph "Fallback to Claude API, graceful degradation messaging"
    def row
      def cell
        def paragraph "Regulatory changes (EU AI Act)"
      def cell
        def paragraph "Low"
      def cell
        def paragraph "Legal review, privacy-first design, compliance monitoring"

  def heading "Assumptions"
    level 3

  def list
    items """Users want AI assistance and are comfortable with the technology
OpenAI API remains stable and cost-effective
35% conversion lift is achievable based on competitor benchmarks
Engineering can deliver streaming SSE within performance budget"""


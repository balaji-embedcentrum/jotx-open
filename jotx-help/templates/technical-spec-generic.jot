  def heading "Data Model"
    level 2

  def paragraph "[Define key data structures, entities, or database schemas]"

  def code
    language json
    text """{
  "entity": {
    "field1": "type",
    "field2": "type"
  }
}"""

  def heading "API Design"
    level 2

  def paragraph "[Define API endpoints, request/response formats, or interface contracts]"

  def code
    language bash
    text """GET /api/resource
POST /api/resource
PUT /api/resource/:id
DELETE /api/resource/:id"""

  def heading "Alternatives Considered"
    level 2

  def paragraph "[Document other approaches you evaluated and why they were not chosen]"

  def list
    items """Alternative 1: [description] - Rejected because [reason]
Alternative 2: [description] - Rejected because [reason]"""

  def heading "Security Considerations"
    level 2

  def list
    items """Authentication: [how users are authenticated]
Authorization: [how permissions are managed]
Data protection: [encryption, PII handling]
Threat model: [potential security risks]"""

  def heading "Testing Strategy"
    level 2

  def list
    items """Unit tests: [coverage goals]
Integration tests: [key scenarios]
Performance tests: [load testing approach]
Security tests: [penetration testing, vulnerability scans]"""

  def heading "Rollout Plan"
    level 2

  def heading "Phases"
    level 3

  def list
    listtype numbered
    items """Phase 1: [milestone] - [date]
Phase 2: [milestone] - [date]
Phase 3: [milestone] - [date]"""

  def heading "Rollback Strategy"
    level 3

  def paragraph "[How will we rollback if something goes wrong?]"

  def heading "Monitoring & Observability"
    level 2

  def list
    items """Metrics: [what we'll measure]
Logs: [what we'll log]
Alerts: [when we'll be notified]
Dashboards: [what we'll visualize]"""


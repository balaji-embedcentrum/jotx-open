hdef jotx TechnicalSpecGeneric

  type page
  title Technical Spec Template
  icon 📐
  author ""
  created 2025-01-01
  tags "technical", "spec", "rfc", "design"

  def table block_1
    columns Key, Value
    rows """Status | Draft
Author | 
Reviewers | 
Target Release | """

  def heading "[Feature/System Name]"

  def paragraph "[One sentence overview of what this spec covers]"

  def divider

  def heading "Overview"
    level 2

  def paragraph "[Provide a high-level summary. What problem are we solving? Why is this important?]"

  def callout "💡 Goal: [State the primary objective or desired outcome]"

  def heading "Background & Context"
    level 2

  def paragraph "[Explain the current situation, existing systems, and why this change is needed]"

  def list
    items """Current system/approach: [description]
Limitations: [what doesn't work]
Business driver: [why now]"""

  def heading "Requirements"
    level 2

  def heading "Functional Requirements"
    level 3

  def list
    listtype numbered
    items """[REQ-1] The system must...
[REQ-2] The system must...
[REQ-3] Users should be able to..."""

  def heading "Non-Functional Requirements"
    level 3

  def list
    items """Performance: [e.g., response time < 200ms]
Scalability: [e.g., support 10k concurrent users]
Security: [e.g., encryption at rest and in transit]
Reliability: [e.g., 99.9% uptime]"""

  def heading "Proposed Solution"
    level 2

  def paragraph "[Describe your proposed approach at a high level]"

  def heading "Architecture Overview"
    level 3

  def paragraph "[Describe the system architecture. Use diagrams where helpful]"

  def code
    language plaintext
    text "[Optional: Add architecture diagram or component description]"

  def heading "Key Components"
    level 3

  def table block_22
    def row
      def header
        text Component
      def header
        text Responsibility
      def header
        text Technology

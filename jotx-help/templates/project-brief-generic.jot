hdef jotx ProjectBriefGeneric

  type page
  title Project Brief Template
  icon 🎯
  author ""
  created 2025-01-01
  tags "project", "planning", "brief"

  def table block_1
    columns Key, Value
    rows """Project Status | Planning
Project Owner | 
Start Date | 
Target Completion | 
Budget | """

  def heading "[Project Name]"

  def paragraph "[One-sentence project description]"

  def divider

  def heading "Project Overview"
    level 2

  def paragraph "[Provide a high-level summary of what this project aims to accomplish and why it matters]"

  def heading "Problem Statement"
    level 2

  def paragraph "[What problem are we solving? What is the current pain point or opportunity?]"

  def heading "Objectives & Goals"
    level 2

  def list
    listtype numbered
    items """[Primary objective 1]
[Primary objective 2]
[Primary objective 3]"""

  def heading "Success Metrics"
    level 2

